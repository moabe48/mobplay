{
  "appId": "com.mobplay.app",
  "appName": "MobPlay",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*"]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "backgroundColor": "#090d16"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
